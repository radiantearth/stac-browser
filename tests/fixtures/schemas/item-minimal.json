{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Minimal STAC Item schema for tests",
  "description": "Self-contained (no remote $refs) stand-in for the STAC Item schema.",
  "type": "object",
  "required": ["type", "id", "properties"],
  "properties": {
    "type": {
      "const": "Feature"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "properties": {
      "type": "object",
      "required": ["datetime"]
    }
  }
}
